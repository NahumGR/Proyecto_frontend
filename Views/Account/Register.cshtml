@model RegisterViewModel

@{
    ViewData["Title"] = "Registro";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <div class="mb-4">
                    <h1 class="h4 fw-light mb-0">@ViewData["Title"]</h1>

                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">

                            <label asp-for="UserName" class="form-label small text-muted mb-1"></label>
                            <input asp-for="UserName" class="form-control form-control-sm rounded-2" placeholder="usuario" autocomplete="username" />

                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small text-muted mb-1"></label>
                            <input asp-for="Email" class="form-control form-control-sm rounded-2" 
                            
                            placeholder="Correo" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small text-muted mb-1"></label>
                            <input asp-for="Password" class="form-control form-control-sm rounded-2" autocomplete="new-password" />
                            
                            
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small text-muted mb-1"></label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-sm rounded-2" 
                            
                            autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mt-4 pt-3 border-top">
                        <a asp-action="Login" class="btn btn-link text-muted text-decoration-none btn-sm px-0">Ya tengo cuenta</a>
                        <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4">Registrarse</button>
                    </div>
                </form>
            </div>
            
            
            
        </div>
    </div>
    
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}