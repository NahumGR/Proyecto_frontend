@model BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4 text-center">

                <h1 class="h5 fw-normal mb-1">Eliminar libro</h1>
                <p class="text-muted small mb-4">¿Estás seguro de que deseas eliminar este libro?</p>

                <div class="bg-light p-3 rounded-3 text-start mb-4">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                        {
                            <img src="~/imagenes/@Model.ImagenUrl" 
                                 class="rounded-2" 
                                 style="width: 80px; height: 110px; object-fit: cover;" 
                                 alt="@Model.Titulo">
                        }
                        else
                        {
                            <img src="~/imagenes/no-image.jpg" 
                                 class="rounded-2" 
                                 style="width: 80px; height: 110px; object-fit: cover;" 
                                 alt="Sin imagen">
                        }
                        <div>
                            <h6 class="mb-0 fw-semibold">@Model.Titulo</h6>
                            <small class="text-muted d-block mb-1">@Model.Autor</small>
                            <small class="text-muted d-block">@Model.Categoria • $@Model.Precio</small>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="swal-delete-form">
                    <input type="hidden" asp-for="ID" />
                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none btn-sm">Cancelar</a>
                        <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4">Sí, eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>