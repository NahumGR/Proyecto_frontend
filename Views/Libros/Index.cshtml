@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

@if (TempData["Mensaje"] != null)
{
    var tipo = TempData["TipoMensaje"] as string ?? "success";
    <div class="alert alert-@tipo alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-light mb-0">Catálogo de Libros</h1>
        <small class="text-muted fs-7">@Model.Count() registrados</small>
    </div>
    <a class="btn btn-dark btn-sm rounded-pill px-3" asp-action="Create">+ Nuevo Libro</a>
</div>

<div class="row g-3">
    @foreach (var libro in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="row g-0 align-items-center h-100">
                    <div class="col-4 h-100 position-relative">
                        <img src="~/imagenes/@libro.ImagenUrl" 
                             class="img-fluid h-100 w-100" 
                             style="object-fit: cover; min-height: 120px;" 
                             alt="@libro.Titulo">
                    </div>
                    <div class="col-8">
                        <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                    <h6 class="card-title mb-0 fw-semibold text-truncate">@libro.Titulo</h6>
                                    @if (libro.Disponible)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fs-8">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fs-8">Prestado</span>
                                    }
                                </div>
                                <p class="card-subtitle text-muted small mb-1 text-truncate">@libro.Autor</p>
                                <p class="text-muted fs-7 mb-2">@libro.Categoria — <span class="fw-medium text-dark">$@libro.Precio</span></p>
                            </div>
                            <div class="d-flex gap-2 align-items-center pt-2 border-top">
                                <a asp-action="Details" asp-route-id="@libro.ID" class="text-dark text-decoration-none small">Ver</a>
                                <span class="text-muted opacity-25">|</span>
                                <a asp-action="Edit" asp-route-id="@libro.ID" class="text-muted text-decoration-none small">Editar</a>
                                <span class="text-muted opacity-25 ms-auto">|</span>
                                <a asp-action="Delete" asp-route-id="@libro.ID" class="text-danger text-decoration-none small">Eliminar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>