@model BibliotecaMVC.Models.Libro
@{
    ViewData["Title"] = "Crear Libro";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h4 fw-light mb-0">@ViewData["Title"]</h1>
                    <a asp-action="Index" class="btn-close" aria-label="Close"></a>
                </div>

                <form asp-action="Create" method="post" class="needs-validation">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Titulo" class="form-label small text-muted mb-1"></label>
                            <input asp-for="Titulo" class="form-control form-control-sm rounded-2" placeholder="Ej: Cien años de soledad" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Autor" class="form-label small text-muted mb-1"></label>
                            <input asp-for="Autor" class="form-control form-control-sm rounded-2" placeholder="Ej: Gabriel García Márquez" />
                            <span asp-validation-for="Autor" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Categoria" class="form-label small text-muted mb-1"></label>
                            <input asp-for="Categoria" class="form-control form-control-sm rounded-2" placeholder="Ej: Novela" />
                            <span asp-validation-for="Categoria" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label small text-muted mb-1"></label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control form-control-sm rounded-2" placeholder="0.00" />
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Disponible" class="form-label small text-muted mb-1"></label>
                            <select asp-for="Disponible" class="form-select form-select-sm rounded-2">
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                            <span asp-validation-for="Disponible" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none btn-sm">Cancelar</a>
                        <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>