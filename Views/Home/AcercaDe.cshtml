@{
    ViewData["Title"] = "Acerca de";
}

<div class="mb-4">
    <h1 class="h4 fw-light mb-0">Acerca de</h1>
    <small class="text-muted fs-7">Conoce más sobre BibliotecaMVC</small>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="row g-0 align-items-center">
        <div class="col-md-8 p-4">
            <h2 class="h5 fw-semibold mb-3">Quienes somos</h2>
            <p class="text-muted mb-0">BibliotecaMVC es un sistema para llevar el control de una biblioteca y donde puedes ver los libros y sus autores y categorías</p>
        </div>
        <div class="col-md-4 text-center p-4">
            <img class="img-fluid rounded" alt="Universidad Evangélica de El Salvador"
                 src="https://upload.wikimedia.org/wikipedia/commons/5/50/Universidad_Evang%C3%A9lica_de_El_Salvador.png?utm_source=es.wikipedia.org&utm_campaign=index&utm_content=original" />
        </div>
    </div>
</div>

<h2 class="h5 fw-light mb-3">¿Qué puedes hacer aquí?</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <h6 class="card-title mb-1 fw-semibold">Consultar libros</h6>
                <small class="text-muted">Catálogo</small>
                <p class="card-text text-muted small mt-2 mb-0">Revisa el listado de libros con su autor, categoría, precio y si está disponible o no.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <h6 class="card-title mb-1 fw-semibold">Autores y categorías</h6>
                <small class="text-muted">Organización</small>
                <p class="card-text text-muted small mt-2 mb-0">Conoce a los autores registrados y agrupa los libros por categoría para ubicarlos más rápido.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-3">
            <div class="card-body p-3">
                <h6 class="card-title mb-1 fw-semibold">Reportes</h6>
                <small class="text-muted">PDF y Excel</small>
                <p class="card-text text-muted small mt-2 mb-0">Los administradores y bibliotecarios pueden descargar el listado de libros en PDF o en Excel.</p>
            </div>
        </div>
    </div>
</div>

<a asp-controller="Home" asp-action="Index" class="btn btn-dark btn-sm rounded-pill px-3">Volver a inicio</a>