@model IEnumerable<BibliotecaMVC.Models.Autor>

@{
	ViewData["Title"] = "Listado de Autores";
}
<h2>Catálogo de Autores</h2>
<h2>Hay @Model.Count() Autores registrados</h2>	

<a class="btn btn-primary" asp-action="Create">Nuevo Autor +</a>
<div class="row">
@foreach(var autor in Model){
<div class="col-md-6">
	<div class="card mb-3">
        <div class="card-body">
            <h5>@autor.Nombre @autor.Apellido</h5>
            <h6>@autor.Nacionalidad</h6>
			<a asp-action="Details" asp-route-id="@autor.ID">Ver</a>
			<a asp-action="Edit" asp-route-id="@autor.ID">Editar</a>
			<a asp-action="Delete" asp-route-id="@autor.ID" class="btn btn-danger btn-sm">Eliminar</a>
        </div>
    </div>
</div>
}
</div>
