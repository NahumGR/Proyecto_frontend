@model IEnumerable<BibliotecaMVC.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-light mb-0">@ViewData["Title"]</h1>
        <small class="text-muted fs-7">@Model.Count() registrados</small>
    </div>
    <a class="btn btn-dark btn-sm rounded-pill px-3" asp-action="Create">+ Nuevo Autor</a>
</div>

<div class="row g-3">
    @foreach (var autor in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="row g-0 align-items-center h-100">
                    <div class="col-4 h-100">
                        <img src="~/imagenes/@autor.ImagenUrl" 
                             class="img-fluid h-100 w-100" 
                             style="object-fit: cover; min-height: 110px;" 
                             alt="@autor.Nombre @autor.Apellido">
                    </div>
                    <div class="col-8">
                        <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                            <div>
                                <h6 class="card-title mb-1 fw-semibold text-truncate">@autor.Nombre @autor.Apellido</h6>
                                <p class="card-subtitle text-muted small mb-2">@autor.Nacionalidad</p>
                            </div>
                            <div class="d-flex gap-2 align-items-center pt-2 border-top">
                                <a asp-action="Details" asp-route-id="@autor.ID" class="text-dark text-decoration-none small">Ver</a>
                                <span class="text-muted opacity-25">|</span>
                                <a asp-action="Edit" asp-route-id="@autor.ID" class="text-muted text-decoration-none small">Editar</a>
                                <span class="text-muted opacity-25 ms-auto">|</span>
                                <a asp-action="Delete" asp-route-id="@autor.ID" class="text-danger text-decoration-none small">Eliminar</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>