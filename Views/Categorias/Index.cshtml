@model IEnumerable<BibliotecaMVC.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-light mb-0">@ViewData["Title"]</h1>
        <small class="text-muted fs-7">@Model.Count() disponibles</small>
    </div>
    <a class="btn btn-dark btn-sm rounded-pill px-3" asp-controller="Categorias" asp-action="Create">+ Nueva Categoría</a>
</div>

<div class="row g-3">
    @foreach (var categoria in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                <img src="~/imagenes/@(string.IsNullOrEmpty(categoria.ImagenUrl) ? "no-image.jpg" : categoria.ImagenUrl)"
                     class="card-img-top"
                     style="height: 200px; object-fit: cover;"
                     alt="@categoria.Nombre" />
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h6 class="card-title mb-1 fw-semibold text-truncate">@categoria.Nombre</h6>
                        <p class="card-subtitle text-muted small mb-3">@categoria.Descripcion</p>
                    </div>
                    <div class="d-flex gap-2 align-items-center pt-2 border-top">
                        <a asp-action="Editar" asp-route-id="@categoria.ID" class="text-muted text-decoration-none small">Editar</a>
                        <span class="text-muted opacity-25 ms-auto">|</span>
                        <a asp-action="Eliminar" asp-route-id="@categoria.ID" class="text-danger text-decoration-none small">Eliminar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        var mensaje = '@(TempData["SuccessMessage"] ?? "")';
        if (mensaje) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: mensaje,
                timer: 2000,
                showConfirmButton: false
            });
        }
    </script>
}