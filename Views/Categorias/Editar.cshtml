@model BibliotecaMVC.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h4 fw-light mb-0">@ViewData["Title"]</h1>
                    
                </div>

                <form asp-action="Editar" method="post">
                    <input type="hidden" asp-for="ID" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label small text-muted mb-1">Nombre</label>
                            <input asp-for="Nombre" class="form-control form-control-sm rounded-2" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label small text-muted mb-1">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control form-control-sm rounded-2" rows="3"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none btn-sm">Cancelar</a>
                        <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>